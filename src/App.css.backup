/* ================================
   BIRDS CARE FINAL BILL DESIGN
================================ */


.bill-page{
    width:100%;
    min-height:100vh;
    background:#eef3ef;
    padding:30px 15px;
}


.bill-container{

    max-width:1200px;
    margin:auto;
    background:white;
    padding:25px;
    border:1px solid #ddd;

}


/* HEADER */

.new-bill-header{

    display:flex;
    justify-content:space-between;
    align-items:center;
    border-bottom:2px solid #ddd;
    padding-bottom:15px;

}


.bill-logo img{

    width:280px;
    height:auto;

}


.invoice-title{

    text-align:right;

}


.invoice-title h1{

    color:#075c3b;
    font-size:32px;
    margin:0;

}


.invoice-title p{

    font-size:18px;
    margin:5px;

}



.address-line{

    padding:10px 0;
    font-size:16px;

}



/* TOP BOXES */


.bill-box-grid{

    display:grid;
    grid-template-columns:1fr 1fr 1.2fr;
    gap:20px;
    margin-top:15px;

}



.bill-box{

    border:1px solid #ccc;
    min-height:180px;

}


.bill-box h3{

    margin:0;
    padding:10px;
    background:#075c3b;
    color:white;
    font-size:18px;

}


.bill-box p{

    margin:12px;
    font-size:15px;

}





/* TABLE */


.items-section{

    margin-top:25px;

}



.items-section h3{

    background:#075c3b;
    color:white;
    padding:10px;
    margin:0;

}



.bill-table{

    width:100%;
    border-collapse:collapse;

}



.bill-table th{

    background:#edf5ee;
    color:#075c3b;

}



.bill-table th,
.bill-table td{

    border:1px solid #ccc;
    padding:10px;
    text-align:center;

}



.product-row{

    display:flex;
    align-items:center;
    gap:15px;
    text-align:left;

}


.bill-product-image{

    width:70px;
    height:60px;
    object-fit:cover;
    border-radius:6px;

}



.product-row p{

    margin:5px 0;
    color:#555;

}




/* TOTAL */


.bill-total-box{

    width:350px;
    margin-left:auto;
    margin-top:15px;
    border:1px solid #ccc;

}



.bill-total-box div{

    display:flex;
    justify-content:space-between;
    padding:10px 15px;

}



.grand-total{

    background:#e5f0e5;
    font-size:20px;
    color:#075c3b;

}




/* BUTTON */


.bill-actions{

    display:flex;
    justify-content:center;
    gap:20px;
    margin-top:35px;

}


.bill-actions button{

    padding:13px 35px;
    border-radius:6px;
    border:none;
    cursor:pointer;
    font-weight:bold;
    font-size:16px;

}



.print-btn{

    background:#075c3b;
    color:white;

}



.shop-btn{

    background:white;
    color:#075c3b;
    border:2px solid #075c3b !important;

}





/* FOOTER */


.bill-footer{

    margin-top:30px;
    border-top:1px solid #ddd;
    padding-top:20px;
    text-align:center;
    color:#075c3b;
    font-size:18px;

}




/* MOBILE */


@media(max-width:700px){


.bill-container{

    padding:15px;

}


.new-bill-header{

    flex-direction:column;
    gap:15px;

}



.bill-logo img{

    width:220px;

}



.invoice-title{

    text-align:center;

}



.bill-box-grid{

    grid-template-columns:1fr;

}



.bill-table{

    font-size:12px;

}



.bill-product-image{

    width:50px;
    height:50px;

}



.bill-total-box{

    width:100%;

}



.bill-actions{

    flex-direction:column;

}


.bill-actions button{

    width:100%;

}


}



/* PRINT */


@media print{


.header,
.nav-menu,
.bill-actions{

    display:none!important;

}


.bill-page{

    padding:0;
    background:white;

}


.bill-container{

    border:none;
    box-shadow:none;

}


}.bill-logo img{
    width:220px;
    height:auto;
    display:block;
    object-fit:contain;
}